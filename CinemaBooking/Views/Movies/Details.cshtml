@model MovieDetails
@{ ViewData["Title"] = Model.Movie.Title; }
<a asp-action="Index" class="small d-inline-block mb-3"><i class="fas fa-arrow-left me-2" aria-hidden="true"></i>All movies</a>
<div class="row g-4 g-lg-5 mb-5"><div class="col-md-4"><img src="@Model.Movie.PosterPath" alt="Poster for @Model.Movie.Title" class="detail-poster rounded-3 shadow" /></div><div class="col-md-8"><span class="badge badge-subtle-primary mb-3">@Model.Movie.Genre</span><h1 class="display-5 fw-semibold">@Model.Movie.Title</h1><p class="text-body-secondary"><i class="far fa-clock me-2" aria-hidden="true"></i>@Model.Movie.DurationMinutes minutes</p><p class="lead fs-9 text-body-secondary preserve-lines">@Model.Movie.Description</p><a href="#screenings" class="btn btn-primary mt-2 mb-4"><i class="fas fa-ticket-alt me-2" aria-hidden="true"></i>Choose your screening</a><h2 class="h5 mb-3">The cast</h2><div class="d-flex flex-wrap gap-4">@foreach (var credit in Model.Movie.MovieActors) { <div class="cast-member"><img src="@credit.Actor.ImagePath" alt="Portrait of @credit.Actor.Name" class="cast-photo" /><span class="small d-block mt-2">@credit.Actor.Name</span></div> }@if (Model.Movie.MovieActors.Count == 0) { <p class="small text-body-secondary">Cast details will be announced soon.</p> }</div></div></div>
<section id="screenings"><div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3"><h2 class="h3 mb-0">Upcoming screenings</h2><span class="small text-body-secondary">All times are local to Cairo</span></div><partial name="_Screenings" model="Model.Screenings" /></section>
