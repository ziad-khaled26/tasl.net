@model IReadOnlyList<ScreeningCard>
@if (Model.Count == 0)
{
<div class="card"><div class="card-body empty-state"><i class="far fa-calendar-alt fa-2x text-primary mb-3" aria-hidden="true"></i><h3 class="h5">More stories are on the way</h3><p class="mb-0 text-body-secondary">There are no upcoming screenings here yet. Explore our other movies and cinemas.</p></div></div>
}
@foreach (var show in Model)
{
<article class="card mb-3"><div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
<div class="screening-date"><strong>@show.StartAt.ToString("dd")</strong><span>@show.StartAt.ToString("MMM")</span></div>
<div class="flex-grow-1"><h3 class="h6 mb-1">@show.MovieTitle</h3><div>@show.CinemaName</div><div class="small text-body-secondary">@CairoClock.Display(show.StartAt) | Cairo</div></div>
<div><strong class="d-block text-primary">@show.Price.ToString("N2") EGP</strong><span class="small @(show.Available > 0 ? "text-success" : "text-danger")">@(show.Available > 0 ? $"{show.Available} tickets available" : "Sold out")</span></div>
@if (show.Available > 0) { <a class="btn btn-primary" asp-area="" asp-controller="Bookings" asp-action="Create" asp-route-id="@show.Id">Book tickets</a> }
else { <span class="badge badge-subtle-danger p-2">Full screening</span> }
</div></article>
}
