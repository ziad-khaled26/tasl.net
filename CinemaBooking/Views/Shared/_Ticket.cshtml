@model Booking
<article class="card ticket mx-auto overflow-hidden"><div class="ticket-banner"><span class="eyebrow text-white">CINEMABOOKING | ADMIT @Model.Quantity</span><h2 class="text-white mt-2 mb-0">@Model.Showtime.Movie.Title</h2></div><div class="card-body p-4 p-md-5"><div class="row g-4"><div class="col-sm-7"><div class="eyebrow mb-2">CINEMA</div><h3 class="h5">@Model.Showtime.Cinema.Name</h3><p class="small text-body-secondary">@Model.Showtime.Cinema.Address</p><div class="eyebrow mb-2 mt-4">SCREENING | CAIRO TIME</div><p class="fw-semibold">@CairoClock.Display(Model.Showtime.StartAt)</p></div><div class="col-sm-5"><div class="eyebrow mb-2">TICKET HOLDER</div><p class="fw-semibold">@Model.CustomerName</p><div class="eyebrow mb-2 mt-4">TICKETS</div><p>@Model.Quantity x @Model.UnitPrice.ToString("N2") EGP<br /><strong class="text-primary fs-7">@Model.TotalAmount.ToString("N2") EGP</strong></p></div></div><div class="ticket-code mt-3"><span class="eyebrow d-block mb-2">BOOKING CODE</span><strong>@Model.Code</strong></div><p class="small text-body-secondary mt-4 mb-0">Arrive 15 minutes early and show this ticket at the cinema. No assigned seats. No online payment collected.</p><p class="small text-body-secondary mt-2 mb-0">Booked @Model.CreatedUtc.ToString("dd MMM yyyy, HH:mm") UTC</p></div></article>
