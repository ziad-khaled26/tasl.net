<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head><partial name="_Head" /></head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<div class="admin-shell">
<aside class="admin-sidebar no-print">
<a class="brand d-block mb-4" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><span class="brand-icon"><i class="fas fa-film" aria-hidden="true"></i></span> CinemaBooking</a>
<div class="eyebrow mb-3">WORKSPACE</div>
<nav class="nav flex-column gap-1" aria-label="Administration">
<a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-chart-pie me-2" aria-hidden="true"></i>Overview</a>
<a class="nav-link" asp-area="Admin" asp-controller="Movies" asp-action="Index"><i class="fas fa-film me-2" aria-hidden="true"></i>Movies</a>
<a class="nav-link" asp-area="Admin" asp-controller="Cinemas" asp-action="Index"><i class="fas fa-building me-2" aria-hidden="true"></i>Cinemas</a>
<a class="nav-link" asp-area="Admin" asp-controller="Actors" asp-action="Index"><i class="fas fa-users me-2" aria-hidden="true"></i>Actors</a>
<a class="nav-link" asp-area="Admin" asp-controller="Showtimes" asp-action="Index"><i class="fas fa-calendar-alt me-2" aria-hidden="true"></i>Showtimes</a>
<a class="nav-link" asp-area="Admin" asp-controller="Bookings" asp-action="Index"><i class="fas fa-ticket-alt me-2" aria-hidden="true"></i>Bookings</a>
</nav>
<div class="border-top mt-4 pt-3"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left me-2" aria-hidden="true"></i>Public website</a><p class="small text-body-secondary mt-4 mb-0">Educational edition<br />Administration is open by design.</p></div>
</aside>
<div class="admin-content">
<header class="admin-topbar no-print"><span class="eyebrow">CINEMA OPERATIONS</span><span class="small text-body-secondary">Cairo time | EGP</span></header>
<main id="main" class="p-3 p-lg-4"><partial name="_Messages" />@RenderBody()</main>
</div>
</div>
<partial name="_Scripts" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
