@model ErrorViewModel
@{ ViewData["Title"] = "Something went wrong"; }
<div class="card"><div class="card-body empty-state"><i class="fas fa-exclamation-circle fa-2x text-warning mb-3" aria-hidden="true"></i><h1 class="h3">We couldn't complete that request</h1><p>Please try again in a moment.</p><p class="small text-body-secondary">Reference: @Model.RequestId</p><a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to home</a></div></div>
