@model IReadOnlyList<Showtime>
@{ ViewData["Title"] = "Showtimes"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h3 mb-1">Showtimes</h1><p class="text-body-secondary small mb-0">Manage individual screenings, prices and ticket capacity. All times are Cairo local time.</p></div><a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus me-2" aria-hidden="true"></i>Add showtime</a></div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Movie</th><th>Cinema</th><th>Screening | Cairo</th><th>Price</th><th>Tickets</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model)
{
var booked = item.Bookings.Sum(x => x.Quantity);
<tr><td class="fw-semibold">@item.Movie.Title</td><td>@item.Cinema.Name</td><td>@CairoClock.Display(item.StartAt)</td><td>@item.TicketPrice.ToString("N2") EGP</td><td>@booked / @item.Capacity booked<br /><a class="small" asp-controller="Bookings" asp-action="Index" asp-route-showtimeId="@item.Id">View bookings</a></td><td><span class="badge @(item.StartAt <= CairoClock.Now ? "badge-subtle-secondary" : booked >= item.Capacity ? "badge-subtle-danger" : "badge-subtle-success")">@(item.StartAt <= CairoClock.Now ? "Started" : booked >= item.Capacity ? "Full" : "Upcoming")</span></td><td><div class="row-actions"><a class="btn btn-falcon-default btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a><a class="btn btn-falcon-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a></div></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center py-5">No screenings yet. Add a showtime to start accepting bookings.</td></tr> }
</tbody></table></div></div>
