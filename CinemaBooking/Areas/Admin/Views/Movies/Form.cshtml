@model MovieForm
@{ ViewData["Title"] = Model.Id == 0 ? "Create movie" : "Edit movie"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1>
<div class="card form-card"><div class="card-body p-4">
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
<input asp-for="Id" type="hidden" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger validation-summary" role="alert"></div>
<div class="mb-3"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger small"></span></div>
<div class="row"><div class="col-sm-6 mb-3"><label asp-for="Genre" class="form-label"></label><input asp-for="Genre" class="form-control" list="genres" /><datalist id="genres"><option value="Drama"></option><option value="Comedy"></option><option value="Adventure"></option><option value="Science Fiction"></option><option value="Thriller"></option><option value="Animation"></option></datalist><span asp-validation-for="Genre" class="text-danger small"></span></div><div class="col-sm-6 mb-3"><label asp-for="DurationMinutes" class="form-label"></label><input asp-for="DurationMinutes" class="form-control" type="number" /><span asp-validation-for="DurationMinutes" class="text-danger small"></span></div></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="5" class="form-control"></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="ActorIds" class="form-label"></label><select asp-for="ActorIds" asp-items="Model.Actors" class="form-select" multiple size="8"></select><span asp-validation-for="ActorIds" class="text-danger small"></span><div class="form-text">Select multiple actors using Ctrl (Windows) or Command (Mac).</div></div>
<partial name="_ImageUpload" model="Model" />
<button type="submit" class="btn btn-primary">Save movie</button><a asp-action="Index" class="btn btn-falcon-default ms-2">Cancel</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
