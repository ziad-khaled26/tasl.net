@model AdminDashboard
@{ ViewData["Title"] = "Overview"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><div class="eyebrow text-primary mb-2">YOUR CINEMA AT A GLANCE</div><h1 class="h3 mb-1">Operations overview</h1><p class="text-body-secondary small mb-0">Live numbers from your cinema programme and ticket bookings.</p></div><a class="btn btn-primary" asp-controller="Showtimes" asp-action="Create"><i class="fas fa-plus me-2" aria-hidden="true"></i>Add showtime</a></div>
<div class="row g-3 mb-4">
@foreach (var metric in new[] { ("Cinemas", Model.Cinemas, "building"), ("Movies", Model.Movies, "film"), ("Actors", Model.Actors, "users"), ("Bookings", Model.Bookings, "ticket-alt"), ("Booked tickets", Model.Tickets, "check-circle") })
{
<div class="col-6 col-xl"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between text-body-secondary mb-2"><span class="small">@metric.Item1</span><i class="fas fa-@metric.Item3 text-primary" aria-hidden="true"></i></div><div class="metric-value">@metric.Item2</div></div></div></div>
}
</div>
<div class="card mb-4"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3"><div><span class="eyebrow">TOTAL BOOKED VALUE</span><h2 class="h3 text-primary mb-0 mt-2">@Model.Revenue.ToString("N2") EGP</h2><p class="small text-body-secondary mb-0 mt-1">Ticket value recorded at booking time. No online payment is collected.</p></div><a class="btn btn-falcon-default" asp-controller="Bookings" asp-action="Index">Manage bookings</a></div></div>
<div class="card"><div class="card-header d-flex justify-content-between"><h2 class="h5 mb-0">Recent bookings</h2><a class="small" asp-controller="Bookings" asp-action="Index">View all</a></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Customer</th><th>Movie</th><th>Tickets</th><th>Total</th><th>Details</th></tr></thead><tbody>
@foreach (var booking in Model.Recent) { <tr><td>@booking.CustomerName</td><td>@booking.Showtime.Movie.Title</td><td>@booking.Quantity</td><td>@booking.TotalAmount.ToString("N2") EGP</td><td><a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id">View booking</a></td></tr> }
@if (Model.Recent.Count == 0) { <tr><td colspan="5" class="text-center py-5 text-body-secondary">No bookings yet. New ticket bookings will appear here.</td></tr> }
</tbody></table></div></div>
