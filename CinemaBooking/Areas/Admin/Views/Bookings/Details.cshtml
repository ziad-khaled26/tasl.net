@model Booking
@{ ViewData["Title"] = "Booking details"; }
<div class="no-print d-flex flex-wrap justify-content-between gap-3 align-items-center mb-4"><div><h1 class="h3">Booking details</h1><p class="mb-0 text-body-secondary small">Customer phone: @Model.Phone</p></div><div class="d-flex gap-2"><button class="btn btn-primary" type="button" data-print>Print ticket</button><a asp-action="Index" class="btn btn-falcon-default">Back to bookings</a></div></div>
<partial name="_Ticket" model="Model" />
